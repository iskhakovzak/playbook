//@version=6
indicator("Earnings Season Tracker & Confidence Scorer", overlay = true, max_labels_count = 500, max_bars_back = 5000)

// ============================================================================
// SECTION 1: USER INPUTS
// ============================================================================

// --- General Settings ---
grp_general = "General Settings"
i_lookback_bars     = input.int(500, "Lookback Bars for Statistics", minval = 50, maxval = 5000, group = grp_general)
i_season_days       = input.int(45, "Earnings Season Length (days)", minval = 14, maxval = 90, group = grp_general)
i_recent_days       = input.int(14, "Recent Window (days)", minval = 5, maxval = 30, group = grp_general)
i_min_samples       = input.int(3, "Min Samples for Probability", minval = 1, maxval = 20, group = grp_general)

// --- Gap Detection ---
grp_gap = "Gap Detection"
i_gap_min_pct       = input.float(2.0, "Minimum Gap % to Classify", minval = 0.5, maxval = 20.0, step = 0.5, group = grp_gap)
i_gap_large_pct     = input.float(5.0, "Large Gap Threshold %", minval = 2.0, maxval = 30.0, step = 0.5, group = grp_gap)

// --- Filtering ---
grp_filter = "Filters"
i_mcap_threshold    = input.float(100.0, "Market Cap Threshold (Billions)", minval = 0.0, maxval = 5000.0, step = 10.0, group = grp_filter)
i_mcap_filter_mode  = input.string("All", "Market Cap Filter", options = ["All", "Above Threshold", "Below Threshold"], group = grp_filter)
i_vol_min           = input.float(100000, "Min Pre-Market Volume", minval = 0, maxval = 10000000, step = 10000, group = grp_filter)
i_sector_filter     = input.string("All", "Sector Filter", options = ["All", "Technology", "Healthcare", "Financial", "Consumer Cyclical", "Consumer Defensive", "Energy", "Industrials", "Basic Materials", "Communication Services", "Real Estate", "Utilities"], group = grp_filter)

// --- Scoring ---
grp_score = "Confidence Scoring"
i_mcap_weight       = input.float(1.2, "Market Cap Multiplier", minval = 0.5, maxval = 2.0, step = 0.05, group = grp_score)
i_vol_weight        = input.float(1.15, "Volume Multiplier", minval = 0.5, maxval = 2.0, step = 0.05, group = grp_score)
i_sector_weight     = input.float(1.1, "Sector Multiplier", minval = 0.5, maxval = 2.0, step = 0.05, group = grp_score)
i_breakout_weight   = input.float(1.1, "Breakout Multiplier", minval = 0.5, maxval = 2.0, step = 0.05, group = grp_score)
i_recency_weight    = input.float(1.2, "Recency Multiplier", minval = 0.5, maxval = 2.0, step = 0.05, group = grp_score)

// --- Visual ---
grp_visual = "Visualization"
i_show_table        = input.bool(true, "Show Dashboard Table", group = grp_visual)
i_show_labels       = input.bool(true, "Show Setup Labels on Chart", group = grp_visual)
i_show_bg           = input.bool(true, "Show Confidence Background", group = grp_visual)
i_show_score_plot   = input.bool(true, "Plot Confidence Score", group = grp_visual)
i_table_position    = input.string("Top Right", "Table Position", options = ["Top Right", "Top Left", "Bottom Right", "Bottom Left", "Top Center", "Bottom Center"], group = grp_visual)
i_table_size        = input.string("Small", "Table Text Size", options = ["Tiny", "Small", "Normal"], group = grp_visual)
i_show_debug        = input.bool(false, "Show Debug Info", group = grp_visual)

// --- Alerts ---
grp_alert = "Alerts"
i_alert_high        = input.bool(true, "Alert on High Confidence (>=70)", group = grp_alert)
i_alert_earnings    = input.bool(true, "Alert on New Earnings Detection", group = grp_alert)
i_alert_shift       = input.bool(true, "Alert on Probability Shift (>10%)", group = grp_alert)

// --- Backtesting ---
grp_backtest = "Backtesting"
i_risk_reward       = input.float(2.0, "Risk:Reward Ratio", minval = 0.5, maxval = 10.0, step = 0.5, group = grp_backtest)
i_base_risk_pct     = input.float(1.0, "Base Risk % of Account", minval = 0.1, maxval = 5.0, step = 0.1, group = grp_backtest)


// ============================================================================
// SECTION 2: CONSTANTS & ENUMS
// ============================================================================

// Setup type constants
int SETUP_GAP_UP_LONG    = 0
int SETUP_GAP_UP_SHORT   = 1
int SETUP_GAP_DOWN_LONG  = 2
int SETUP_GAP_DOWN_SHORT = 3
int SETUP_GREEN_TURRET   = 4
int SETUP_PREMARKET      = 5
int SETUP_SECOND_MOVE    = 6
int SETUP_DAILY_BREAKOUT = 7
int SETUP_COUNT          = 8

// Confidence levels
float CONF_HIGH   = 70.0
float CONF_MEDIUM = 50.0
float CONF_LOW    = 30.0

// Price position constants
int POS_AT_HIGHS = 2
int POS_MIDDLE   = 1
int POS_AT_LOWS  = 0

// Setup names for display
setup_name(int id) =>
    switch id
        0 => "Gap Up Long"
        1 => "Gap Up Short"
        2 => "Gap Dn Long"
        3 => "Gap Dn Short"
        4 => "Green Turret"
        5 => "Pre-Mkt Move"
        6 => "2nd Movement"
        7 => "Daily Brkout"
        => "Unknown"

setup_short_name(int id) =>
    switch id
        0 => "GUL"
        1 => "GUS"
        2 => "GDL"
        3 => "GDS"
        4 => "GT"
        5 => "PM"
        6 => "2M"
        7 => "DB"
        => "?"


// ============================================================================
// SECTION 3: DATA ACQUISITION
// ============================================================================

// --- Earnings Data ---
earnings_actual   = request.earnings(syminfo.tickerid, earnings.actual)
earnings_estimate = request.earnings(syminfo.tickerid, earnings.estimate)

// --- Fundamental Data ---
shares_outstanding = request.financial(syminfo.tickerid, "TOTAL_SHARES_OUTSTANDING", "FQ")
market_cap_raw     = close * nz(shares_outstanding, 0)
market_cap_billions = market_cap_raw / 1e9

// --- Multi-Timeframe Data ---
// Daily data for gap calculations
[d_open, d_high, d_low, d_close, d_volume] = request.security(syminfo.tickerid, "D", [open, high, low, close, volume])
d_prev_close = request.security(syminfo.tickerid, "D", close[1])
d_prev_high  = request.security(syminfo.tickerid, "D", high[1])
d_prev_low   = request.security(syminfo.tickerid, "D", low[1])

// Weekly data for trend context
w_high = request.security(syminfo.tickerid, "W", high)
w_low  = request.security(syminfo.tickerid, "W", low)

// 52-week high/low for price position
yearly_high = ta.highest(d_high, 252)
yearly_low  = ta.lowest(d_low, 252)

// Current sector
current_sector = syminfo.sector


// ============================================================================
// SECTION 4: DETECTION ENGINE
// ============================================================================

// --- 4.1 Earnings Detection ---
// Detect earnings bars by checking for new earnings data
var float prev_earnings = na
earnings_changed = not na(earnings_actual) and (na(prev_earnings) or earnings_actual != prev_earnings)
is_earnings_bar = earnings_changed
if not na(earnings_actual)
    prev_earnings := earnings_actual

// --- 4.2 Gap Detection ---
gap_pct = nz(d_prev_close) > 0 ? ((d_open - nz(d_prev_close)) / nz(d_prev_close)) * 100 : 0.0
is_gap_up   = gap_pct >= i_gap_min_pct
is_gap_down = gap_pct <= -i_gap_min_pct
is_large_gap = math.abs(gap_pct) >= i_gap_large_pct
gap_direction = is_gap_up ? 1 : is_gap_down ? -1 : 0

// --- 4.3 Green Turret Detection ---
// First candle after open is green (close > open)
is_first_bar_of_day = ta.change(time("D")) != 0
var bool first_candle_green = false
var bool green_turret_today = false

if is_first_bar_of_day
    first_candle_green := false
    green_turret_today := false

if is_first_bar_of_day and close > open
    first_candle_green := true

// Green turret: earnings gap + first candle green + upward spike
green_turret_today := first_candle_green and is_gap_up

// --- 4.4 Pre-Market Volume Detection ---
// Approximate pre-market activity using volume in the first minutes
var float premarket_volume = 0.0
if is_first_bar_of_day
    premarket_volume := volume
has_premarket_volume = premarket_volume >= i_vol_min

// --- 4.5 Daily Breakout Detection ---
is_daily_breakout_up   = d_high > nz(d_prev_high) and nz(d_prev_high) > 0
is_daily_breakout_down = d_low < nz(d_prev_low) and nz(d_prev_low) > 0
is_daily_breakout = is_daily_breakout_up or is_daily_breakout_down

// --- 4.6 Price Position Classification ---
range_52w = yearly_high - yearly_low
price_position_raw = range_52w > 0 ? (close - yearly_low) / range_52w : 0.5
price_position = price_position_raw > 0.75 ? POS_AT_HIGHS : price_position_raw < 0.25 ? POS_AT_LOWS : POS_MIDDLE

// --- 4.7 Second Movement Detection ---
// After initial post-open move, does price make a continuation?
var float open_of_day = na
var float first_move_high = na
var float first_move_low = na
var int bars_since_open = 0

if is_first_bar_of_day
    open_of_day := open
    first_move_high := high
    first_move_low := low
    bars_since_open := 0
else
    bars_since_open += 1

if bars_since_open <= 6 and bars_since_open > 0  // First 30 min (on 5-min chart)
    first_move_high := math.max(nz(first_move_high), high)
    first_move_low  := math.min(nz(first_move_low, low), low)

// Second movement: price exceeds first 30-min range after pullback
is_second_move_long  = bars_since_open > 6 and high > nz(first_move_high) and close > open
is_second_move_short = bars_since_open > 6 and low < nz(first_move_low) and close < open

// --- 4.8 Post-Open Continuation/Reversal ---
// After gap up: continuation = price goes higher; reversal = price drops below open
post_open_continuation = (is_gap_up and close > d_open) or (is_gap_down and close < d_open)
post_open_reversal     = (is_gap_up and close < d_open) or (is_gap_down and close > d_open)


// ============================================================================
// SECTION 5: SETUP CLASSIFICATION & OUTCOME TRACKING
// ============================================================================

// --- Storage Arrays ---
var array<int>   arr_setup_type    = array.new<int>(0)
var array<int>   arr_outcome       = array.new<int>(0)    // 0 or 1
var array<float> arr_gap_pct       = array.new<float>(0)
var array<float> arr_mcap          = array.new<float>(0)
var array<float> arr_volume        = array.new<float>(0)
var array<int>   arr_timestamp     = array.new<int>(0)
var array<int>   arr_price_pos     = array.new<int>(0)
var array<bool>  arr_has_breakout  = array.new<bool>(0)
var array<string> arr_sector       = array.new<string>(0)

// --- Outcome determination ---
// Use end-of-day close vs open to determine if setup "worked"
// For gap-up long: worked if close > open (continuation)
// For gap-up short: worked if close < open (reversal)
// For gap-down short: worked if close < open (continuation)
// For gap-down long: worked if close > open (reversal)
var int last_earnings_bar = 0
var int last_gap_dir = 0
var bool pending_outcome = false
var int pending_setup = -1

// Track setup on earnings day
if is_earnings_bar and timeframe.isdaily
    pending_outcome := true
    last_gap_dir := gap_direction
    last_earnings_bar := bar_index

// Record outcomes at end of earnings day (simplified: use daily close)
if pending_outcome and timeframe.isdaily and bar_index > last_earnings_bar

    // Determine outcome based on close vs open
    float eod_result = d_close - d_open
    bool continuation = eod_result > 0 and last_gap_dir > 0 or eod_result < 0 and last_gap_dir < 0

    // Gap Up setups
    if last_gap_dir > 0
        // Gap Up Long (continuation)
        array.push(arr_setup_type, SETUP_GAP_UP_LONG)
        array.push(arr_outcome, continuation ? 1 : 0)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

        // Gap Up Short (reversal)
        array.push(arr_setup_type, SETUP_GAP_UP_SHORT)
        array.push(arr_outcome, continuation ? 0 : 1)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    // Gap Down setups
    if last_gap_dir < 0
        // Gap Down Short (continuation)
        array.push(arr_setup_type, SETUP_GAP_DOWN_SHORT)
        array.push(arr_outcome, continuation ? 1 : 0)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

        // Gap Down Long (reversal)
        array.push(arr_setup_type, SETUP_GAP_DOWN_LONG)
        array.push(arr_outcome, continuation ? 0 : 1)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    // Green Turret
    if green_turret_today
        array.push(arr_setup_type, SETUP_GREEN_TURRET)
        array.push(arr_outcome, eod_result < 0 ? 1 : 0)  // GT is a short setup after spike
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    // Daily Breakout
    if is_daily_breakout
        array.push(arr_setup_type, SETUP_DAILY_BREAKOUT)
        array.push(arr_outcome, continuation ? 1 : 0)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    // Pre-market move
    if has_premarket_volume
        array.push(arr_setup_type, SETUP_PREMARKET)
        array.push(arr_outcome, continuation ? 1 : 0)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    // Second movement
    if is_second_move_long or is_second_move_short
        array.push(arr_setup_type, SETUP_SECOND_MOVE)
        array.push(arr_outcome, is_second_move_long and continuation or is_second_move_short and not continuation ? 1 : 0)
        array.push(arr_gap_pct, gap_pct)
        array.push(arr_mcap, market_cap_billions)
        array.push(arr_volume, premarket_volume)
        array.push(arr_timestamp, int(time))
        array.push(arr_price_pos, price_position)
        array.push(arr_has_breakout, is_daily_breakout)
        array.push(arr_sector, current_sector)

    pending_outcome := false


// ============================================================================
// SECTION 6: PROBABILITY & CONFIDENCE SCORING ENGINE
// ============================================================================

// --- Helper: Calculate probability for a setup type with optional filters ---
calc_probability(int setup_type, bool use_mcap_filter, bool use_vol_filter, bool use_sector_filter, bool use_recent_only) =>
    int total = 0
    int success = 0
    int n = array.size(arr_setup_type)
    int recent_cutoff = int(timenow - i_recent_days * 86400000)
    int season_cutoff = int(timenow - i_season_days * 86400000)

    if n > 0
        for i = 0 to n - 1
            if array.get(arr_setup_type, i) == setup_type
                // Time filter
                int ts = array.get(arr_timestamp, i)
                bool time_ok = use_recent_only ? ts >= recent_cutoff : ts >= season_cutoff

                // Market cap filter
                float mcap = array.get(arr_mcap, i)
                bool mcap_ok = true
                if use_mcap_filter
                    if i_mcap_filter_mode == "Above Threshold"
                        mcap_ok := mcap >= i_mcap_threshold
                    else if i_mcap_filter_mode == "Below Threshold"
                        mcap_ok := mcap < i_mcap_threshold
                    else
                        mcap_ok := true

                // Volume filter
                float vol = array.get(arr_volume, i)
                bool vol_ok = use_vol_filter ? vol >= i_vol_min : true

                // Sector filter
                string sec = array.get(arr_sector, i)
                bool sec_ok = use_sector_filter and i_sector_filter != "All" ? sec == i_sector_filter : true

                if time_ok and mcap_ok and vol_ok and sec_ok
                    total += 1
                    if array.get(arr_outcome, i) == 1
                        success += 1

    float prob = total >= i_min_samples ? (float(success) / float(total)) * 100.0 : na
    [prob, total, success]


// --- Calculate probabilities for all setup types ---
// Full season probabilities
[prob_gul, tot_gul, suc_gul]   = calc_probability(SETUP_GAP_UP_LONG, false, false, false, false)
[prob_gus, tot_gus, suc_gus]   = calc_probability(SETUP_GAP_UP_SHORT, false, false, false, false)
[prob_gdl, tot_gdl, suc_gdl]   = calc_probability(SETUP_GAP_DOWN_LONG, false, false, false, false)
[prob_gds, tot_gds, suc_gds]   = calc_probability(SETUP_GAP_DOWN_SHORT, false, false, false, false)
[prob_gt, tot_gt, suc_gt]      = calc_probability(SETUP_GREEN_TURRET, false, false, false, false)
[prob_pm, tot_pm, suc_pm]      = calc_probability(SETUP_PREMARKET, false, false, false, false)
[prob_sm, tot_sm, suc_sm]      = calc_probability(SETUP_SECOND_MOVE, false, false, false, false)
[prob_db, tot_db, suc_db]      = calc_probability(SETUP_DAILY_BREAKOUT, false, false, false, false)

// Recent window probabilities
[rprob_gul, rtot_gul, rsuc_gul] = calc_probability(SETUP_GAP_UP_LONG, false, false, false, true)
[rprob_gus, rtot_gus, rsuc_gus] = calc_probability(SETUP_GAP_UP_SHORT, false, false, false, true)
[rprob_gdl, rtot_gdl, rsuc_gdl] = calc_probability(SETUP_GAP_DOWN_LONG, false, false, false, true)
[rprob_gds, rtot_gds, rsuc_gds] = calc_probability(SETUP_GAP_DOWN_SHORT, false, false, false, true)
[rprob_gt, rtot_gt, rsuc_gt]    = calc_probability(SETUP_GREEN_TURRET, false, false, false, true)
[rprob_pm, rtot_pm, rsuc_pm]    = calc_probability(SETUP_PREMARKET, false, false, false, true)
[rprob_sm, rtot_sm, rsuc_sm]    = calc_probability(SETUP_SECOND_MOVE, false, false, false, true)
[rprob_db, rtot_db, rsuc_db]    = calc_probability(SETUP_DAILY_BREAKOUT, false, false, false, true)

// Filtered probabilities (with all active filters)
bool use_mcap = i_mcap_filter_mode != "All"
bool use_vol  = i_vol_min > 0
bool use_sec  = i_sector_filter != "All"

[fprob_gul, ftot_gul, fsuc_gul] = calc_probability(SETUP_GAP_UP_LONG, use_mcap, use_vol, use_sec, false)
[fprob_gus, ftot_gus, fsuc_gus] = calc_probability(SETUP_GAP_UP_SHORT, use_mcap, use_vol, use_sec, false)
[fprob_gdl, ftot_gdl, fsuc_gdl] = calc_probability(SETUP_GAP_DOWN_LONG, use_mcap, use_vol, use_sec, false)
[fprob_gds, ftot_gds, fsuc_gds] = calc_probability(SETUP_GAP_DOWN_SHORT, use_mcap, use_vol, use_sec, false)
[fprob_gt, ftot_gt, fsuc_gt]    = calc_probability(SETUP_GREEN_TURRET, use_mcap, use_vol, use_sec, false)
[fprob_pm, ftot_pm, fsuc_pm]    = calc_probability(SETUP_PREMARKET, use_mcap, use_vol, use_sec, false)
[fprob_sm, ftot_sm, fsuc_sm]    = calc_probability(SETUP_SECOND_MOVE, use_mcap, use_vol, use_sec, false)
[fprob_db, ftot_db, fsuc_db]    = calc_probability(SETUP_DAILY_BREAKOUT, use_mcap, use_vol, use_sec, false)


// --- Confidence Score Calculation ---
calc_confidence(float base_prob, float recent_prob, bool mcap_match, bool vol_match, bool sector_match, bool breakout_match) =>
    if na(base_prob)
        float(na)
    else
        float score = base_prob
        // Apply multipliers when conditions are favorable
        if mcap_match
            score *= i_mcap_weight
        if vol_match
            score *= i_vol_weight
        if sector_match
            score *= i_sector_weight
        if breakout_match
            score *= i_breakout_weight
        // Recency boost: if recent probability is better than season
        if not na(recent_prob) and recent_prob > base_prob
            score *= i_recency_weight
        math.min(score, 100.0)

// Current conditions
bool mcap_match    = (i_mcap_filter_mode == "Above Threshold" and market_cap_billions >= i_mcap_threshold) or (i_mcap_filter_mode == "Below Threshold" and market_cap_billions < i_mcap_threshold) or i_mcap_filter_mode == "All"
bool vol_match     = premarket_volume >= i_vol_min
bool sector_match  = i_sector_filter == "All" or current_sector == i_sector_filter
bool breakout_match = is_daily_breakout

// Confidence scores for each setup
float conf_gul = calc_confidence(prob_gul, rprob_gul, mcap_match, vol_match, sector_match, breakout_match)
float conf_gus = calc_confidence(prob_gus, rprob_gus, mcap_match, vol_match, sector_match, breakout_match)
float conf_gdl = calc_confidence(prob_gdl, rprob_gdl, mcap_match, vol_match, sector_match, breakout_match)
float conf_gds = calc_confidence(prob_gds, rprob_gds, mcap_match, vol_match, sector_match, breakout_match)
float conf_gt  = calc_confidence(prob_gt, rprob_gt, mcap_match, vol_match, sector_match, breakout_match)
float conf_pm  = calc_confidence(prob_pm, rprob_pm, mcap_match, vol_match, sector_match, breakout_match)
float conf_sm  = calc_confidence(prob_sm, rprob_sm, mcap_match, vol_match, sector_match, breakout_match)
float conf_db  = calc_confidence(prob_db, rprob_db, mcap_match, vol_match, sector_match, breakout_match)

// --- Determine Active Setup & Best Confidence ---
var float active_confidence = na
var int   active_setup_type = -1
var string active_signal_text = ""

if is_earnings_bar
    // Find the highest confidence setup currently active
    float best_conf = 0.0
    int best_type = -1

    if is_gap_up and not na(conf_gul) and conf_gul > best_conf
        best_conf := conf_gul
        best_type := SETUP_GAP_UP_LONG
    if is_gap_up and not na(conf_gus) and conf_gus > best_conf
        best_conf := conf_gus
        best_type := SETUP_GAP_UP_SHORT
    if is_gap_down and not na(conf_gdl) and conf_gdl > best_conf
        best_conf := conf_gdl
        best_type := SETUP_GAP_DOWN_LONG
    if is_gap_down and not na(conf_gds) and conf_gds > best_conf
        best_conf := conf_gds
        best_type := SETUP_GAP_DOWN_SHORT
    if green_turret_today and not na(conf_gt) and conf_gt > best_conf
        best_conf := conf_gt
        best_type := SETUP_GREEN_TURRET
    if has_premarket_volume and not na(conf_pm) and conf_pm > best_conf
        best_conf := conf_pm
        best_type := SETUP_PREMARKET
    if is_daily_breakout and not na(conf_db) and conf_db > best_conf
        best_conf := conf_db
        best_type := SETUP_DAILY_BREAKOUT

    active_confidence := best_conf
    active_setup_type := best_type
    active_signal_text := best_type >= 0 ? setup_name(best_type) + " | " + str.tostring(best_conf, "#.0") : "No Signal"


// ============================================================================
// SECTION 7: BACKTESTING P&L TRACKER
// ============================================================================

var float cumulative_pnl = 0.0
var int   total_trades   = 0
var int   winning_trades = 0
var int   losing_trades  = 0
var float max_drawdown   = 0.0
var float peak_pnl       = 0.0
var float hypothetical_pnl = 0.0

// On each recorded outcome, track hypothetical P&L
int n_outcomes = array.size(arr_outcome)
if n_outcomes > 0 and barstate.islast
    cumulative_pnl := 0.0
    total_trades := 0
    winning_trades := 0
    losing_trades := 0

    for i = 0 to n_outcomes - 1
        int outcome = array.get(arr_outcome, i)
        total_trades += 1
        if outcome == 1
            winning_trades += 1
            cumulative_pnl += i_base_risk_pct * i_risk_reward
        else
            losing_trades += 1
            cumulative_pnl -= i_base_risk_pct

        peak_pnl := math.max(peak_pnl, cumulative_pnl)
        float dd = peak_pnl - cumulative_pnl
        max_drawdown := math.max(max_drawdown, dd)

float win_rate = total_trades > 0 ? (float(winning_trades) / float(total_trades)) * 100.0 : 0.0
float profit_factor = losing_trades > 0 and winning_trades > 0 ? (float(winning_trades) * i_risk_reward) / float(losing_trades) : 0.0


// ============================================================================
// SECTION 8: VISUALIZATION - DASHBOARD TABLE
// ============================================================================

get_table_pos() =>
    switch i_table_position
        "Top Right"     => position.top_right
        "Top Left"      => position.top_left
        "Bottom Right"  => position.bottom_right
        "Bottom Left"   => position.bottom_left
        "Top Center"    => position.top_center
        "Bottom Center" => position.bottom_center
        => position.top_right

get_text_size() =>
    switch i_table_size
        "Tiny"   => size.tiny
        "Small"  => size.small
        "Normal" => size.normal
        => size.small

conf_color(float conf) =>
    if na(conf)
        color.gray
    else if conf >= CONF_HIGH
        color.new(color.green, 20)
    else if conf >= CONF_MEDIUM
        color.new(color.orange, 20)
    else if conf >= CONF_LOW
        color.new(color.yellow, 30)
    else
        color.new(color.red, 20)

prob_color(float prob) =>
    if na(prob)
        color.gray
    else if prob >= 65
        color.new(color.green, 30)
    else if prob >= 50
        color.new(color.orange, 30)
    else
        color.new(color.red, 30)

format_prob(float p) =>
    na(p) ? "---" : str.tostring(p, "#.0") + "%"

format_conf(float c) =>
    if na(c)
        "---"
    else
        string level = c >= CONF_HIGH ? " H" : c >= CONF_MEDIUM ? " M" : c >= CONF_LOW ? " L" : " X"
        str.tostring(c, "#.0") + level

var table dashboard = na

if i_show_table and barstate.islast
    // Create table: 9 columns x 12 rows
    dashboard := table.new(get_table_pos(), 9, 14, bgcolor = color.new(color.black, 85), border_width = 1, border_color = color.new(color.gray, 50), frame_width = 2, frame_color = color.new(color.white, 70))
    string txt_size = get_text_size()

    // --- Header Row ---
    table.cell(dashboard, 0, 0, "EARNINGS TRACKER", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60), text_halign = text.align_left)
    table.cell(dashboard, 1, 0, syminfo.ticker, text_color = color.yellow, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 2, 0, current_sector, text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 3, 0, "MCap: " + str.tostring(market_cap_billions, "#.1") + "B", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 4, 0, "", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 5, 0, "", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 6, 0, "", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 7, 0, "", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.cell(dashboard, 8, 0, "", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.blue, 60))
    table.merge_cells(dashboard, 4, 0, 8, 0)

    // --- Column Headers ---
    table.cell(dashboard, 0, 1, "Setup Type", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 1, 1, "Total", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 2, 1, "Won", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 3, 1, "Prob%", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 4, 1, str.tostring(i_recent_days) + "D Prob%", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 5, 1, "Filt Prob%", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 6, 1, "Score", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 7, 1, "Filt Tot", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))
    table.cell(dashboard, 8, 1, "Filt Won", text_color = color.white, text_size = txt_size, bgcolor = color.new(color.gray, 60))

    // --- Data Rows ---
    // Row helper
    fill_row(int row, string name, int total, int success, float prob, float rprob, float fprob, float conf, int ftotal, int fsuccess) =>
        table.cell(dashboard, 0, row, name, text_color = color.white, text_size = txt_size, text_halign = text.align_left)
        table.cell(dashboard, 1, row, str.tostring(total), text_color = color.white, text_size = txt_size)
        table.cell(dashboard, 2, row, str.tostring(success), text_color = color.white, text_size = txt_size)
        table.cell(dashboard, 3, row, format_prob(prob), text_color = color.white, text_size = txt_size, bgcolor = prob_color(prob))
        table.cell(dashboard, 4, row, format_prob(rprob), text_color = color.white, text_size = txt_size, bgcolor = prob_color(rprob))
        table.cell(dashboard, 5, row, format_prob(fprob), text_color = color.white, text_size = txt_size, bgcolor = prob_color(fprob))
        table.cell(dashboard, 6, row, format_conf(conf), text_color = color.white, text_size = txt_size, bgcolor = conf_color(conf))
        table.cell(dashboard, 7, row, str.tostring(ftotal), text_color = color.white, text_size = txt_size)
        table.cell(dashboard, 8, row, str.tostring(fsuccess), text_color = color.white, text_size = txt_size)

    fill_row(2, "Gap Up Long",     tot_gul, suc_gul, prob_gul, rprob_gul, fprob_gul, conf_gul, ftot_gul, fsuc_gul)
    fill_row(3, "Gap Up Short",    tot_gus, suc_gus, prob_gus, rprob_gus, fprob_gus, conf_gus, ftot_gus, fsuc_gus)
    fill_row(4, "Gap Dn Long",     tot_gdl, suc_gdl, prob_gdl, rprob_gdl, fprob_gdl, conf_gdl, ftot_gdl, fsuc_gdl)
    fill_row(5, "Gap Dn Short",    tot_gds, suc_gds, prob_gds, rprob_gds, fprob_gds, conf_gds, ftot_gds, fsuc_gds)
    fill_row(6, "Green Turret",    tot_gt, suc_gt, prob_gt, rprob_gt, fprob_gt, conf_gt, ftot_gt, fsuc_gt)
    fill_row(7, "Pre-Mkt Move",    tot_pm, suc_pm, prob_pm, rprob_pm, fprob_pm, conf_pm, ftot_pm, fsuc_pm)
    fill_row(8, "2nd Movement",    tot_sm, suc_sm, prob_sm, rprob_sm, fprob_sm, conf_sm, ftot_sm, fsuc_sm)
    fill_row(9, "Daily Brkout",    tot_db, suc_db, prob_db, rprob_db, fprob_db, conf_db, ftot_db, fsuc_db)

    // --- Filter Status Row ---
    string filter_text = "Filters:"
    if i_mcap_filter_mode != "All"
        filter_text += " MCap " + i_mcap_filter_mode + " " + str.tostring(i_mcap_threshold, "#") + "B |"
    if i_vol_min > 0
        filter_text += " Vol>" + str.tostring(i_vol_min, "#") + " |"
    if i_sector_filter != "All"
        filter_text += " " + i_sector_filter + " |"
    if filter_text == "Filters:"
        filter_text += " None (showing all)"

    table.cell(dashboard, 0, 10, filter_text, text_color = color.aqua, text_size = txt_size, text_halign = text.align_left)
    table.cell(dashboard, 1, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 2, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 3, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 4, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 5, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 6, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 7, 10, "", bgcolor = color.new(color.black, 85))
    table.cell(dashboard, 8, 10, "", bgcolor = color.new(color.black, 85))
    table.merge_cells(dashboard, 0, 10, 8, 10)

    // --- Active Signal Row ---
    string sig_text = active_setup_type >= 0 ? "ACTIVE: " + active_signal_text : "No Active Signal"
    color sig_bg = active_setup_type >= 0 ? conf_color(active_confidence) : color.new(color.gray, 60)
    table.cell(dashboard, 0, 11, sig_text, text_color = color.white, text_size = txt_size, bgcolor = sig_bg, text_halign = text.align_left)
    table.cell(dashboard, 1, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 2, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 3, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 4, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 5, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 6, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 7, 11, "", bgcolor = sig_bg)
    table.cell(dashboard, 8, 11, "", bgcolor = sig_bg)
    table.merge_cells(dashboard, 0, 11, 8, 11)

    // --- Backtest Summary Row ---
    string bt_text = "Backtest: " + str.tostring(total_trades) + " trades | WR: " + str.tostring(win_rate, "#.1") + "% | PF: " + str.tostring(profit_factor, "#.2") + " | P&L: " + str.tostring(cumulative_pnl, "#.1") + "R | MaxDD: " + str.tostring(max_drawdown, "#.1") + "R"
    table.cell(dashboard, 0, 12, bt_text, text_color = cumulative_pnl >= 0 ? color.lime : color.red, text_size = txt_size, bgcolor = color.new(color.black, 70), text_halign = text.align_left)
    table.cell(dashboard, 1, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 2, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 3, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 4, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 5, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 6, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 7, 12, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 8, 12, "", bgcolor = color.new(color.black, 70))
    table.merge_cells(dashboard, 0, 12, 8, 12)

    // --- Price Position Row ---
    string pos_text = "Price Position: " + (price_position == POS_AT_HIGHS ? "AT HIGHS" : price_position == POS_AT_LOWS ? "AT LOWS" : "MIDDLE") + " | Gap: " + str.tostring(gap_pct, "#.1") + "% | PM Vol: " + str.tostring(premarket_volume, "#")
    table.cell(dashboard, 0, 13, pos_text, text_color = color.white, text_size = txt_size, bgcolor = color.new(color.black, 70), text_halign = text.align_left)
    table.cell(dashboard, 1, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 2, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 3, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 4, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 5, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 6, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 7, 13, "", bgcolor = color.new(color.black, 70))
    table.cell(dashboard, 8, 13, "", bgcolor = color.new(color.black, 70))
    table.merge_cells(dashboard, 0, 13, 8, 13)


// ============================================================================
// SECTION 9: CHART ANNOTATIONS
// ============================================================================

// --- Labels on earnings bars ---
if i_show_labels and is_earnings_bar
    string lbl_text = ""
    color lbl_color = color.gray
    label.style lbl_style = label.style_label_down

    if is_gap_up
        lbl_text := "GAP UP " + str.tostring(gap_pct, "#.1") + "%"
        lbl_color := color.new(color.green, 30)
        lbl_style := label.style_label_down
    else if is_gap_down
        lbl_text := "GAP DN " + str.tostring(gap_pct, "#.1") + "%"
        lbl_color := color.new(color.red, 30)
        lbl_style := label.style_label_up

    if green_turret_today
        lbl_text += "\nGREEN TURRET"

    if active_setup_type >= 0
        lbl_text += "\nConf: " + str.tostring(active_confidence, "#.0")

    if str.length(lbl_text) > 0
        label.new(bar_index, is_gap_up ? high : low, lbl_text, color = lbl_color, textcolor = color.white, style = lbl_style, size = size.small)


// --- Background coloring based on confidence ---
bgcolor(i_show_bg and is_earnings_bar and active_confidence >= CONF_HIGH ? color.new(color.green, 90) : i_show_bg and is_earnings_bar and active_confidence >= CONF_MEDIUM ? color.new(color.orange, 92) : i_show_bg and is_earnings_bar and not na(active_confidence) ? color.new(color.red, 92) : na)


// ============================================================================
// SECTION 10: SCORE PLOTS
// ============================================================================

// Plot confidence score in a separate pane (only on earnings bars)
plot(i_show_score_plot and is_earnings_bar ? active_confidence : na, "Confidence Score", color = conf_color(active_confidence), linewidth = 2, style = plot.style_columns, display = display.pane)

// Reference lines for confidence levels
hline(CONF_HIGH, "High Confidence", color = color.new(color.green, 70), linestyle = hline.style_dashed, display = display.pane)
hline(CONF_MEDIUM, "Medium Confidence", color = color.new(color.orange, 70), linestyle = hline.style_dashed, display = display.pane)
hline(CONF_LOW, "Low Confidence", color = color.new(color.red, 70), linestyle = hline.style_dashed, display = display.pane)


// ============================================================================
// SECTION 11: ALERT CONDITIONS
// ============================================================================

// High confidence alert
alertcondition(is_earnings_bar and active_confidence >= CONF_HIGH, title = "High Confidence Setup", message = "HIGH CONFIDENCE earnings setup detected!\nSetup: {{plot_0}}\nTicker: {{ticker}}\nConfidence: " + str.tostring(active_confidence, "#.0"))

// Earnings detected alert
alertcondition(is_earnings_bar, title = "Earnings Detected", message = "Earnings report detected for {{ticker}}\nGap: " + str.tostring(gap_pct, "#.1") + "%\nDirection: " + (is_gap_up ? "GAP UP" : is_gap_down ? "GAP DOWN" : "FLAT"))

// Probability shift detection
var float prev_best_prob = na
float current_best_prob = na(prob_gul) ? 0 : math.max(nz(prob_gul), math.max(nz(prob_gus), math.max(nz(prob_gdl), math.max(nz(prob_gds), math.max(nz(prob_gt), math.max(nz(prob_pm), math.max(nz(prob_sm), nz(prob_db))))))))
bool prob_shift = not na(prev_best_prob) and math.abs(current_best_prob - prev_best_prob) > 10
prev_best_prob := current_best_prob

alertcondition(prob_shift, title = "Probability Shift", message = "Significant probability shift detected for {{ticker}}!\nPrevious best: " + str.tostring(nz(prev_best_prob), "#.0") + "%\nCurrent best: " + str.tostring(current_best_prob, "#.0") + "%")


// ============================================================================
// SECTION 12: DEBUG / TELEMETRY OUTPUT
// ============================================================================

// Debug information plotted to data window
plot(i_show_debug ? gap_pct : na, "Debug: Gap%", display = display.data_window)
plot(i_show_debug ? market_cap_billions : na, "Debug: MCap(B)", display = display.data_window)
plot(i_show_debug ? premarket_volume : na, "Debug: PM Vol", display = display.data_window)
plot(i_show_debug ? float(price_position) : na, "Debug: Price Pos", display = display.data_window)
plot(i_show_debug ? float(array.size(arr_setup_type)) : na, "Debug: Total Setups", display = display.data_window)
plot(i_show_debug ? active_confidence : na, "Debug: Active Conf", display = display.data_window)
plot(i_show_debug ? float(is_earnings_bar ? 1 : 0) : na, "Debug: Is Earnings", display = display.data_window)
plot(i_show_debug ? float(is_gap_up ? 1 : is_gap_down ? -1 : 0) : na, "Debug: Gap Dir", display = display.data_window)

// End of indicator
